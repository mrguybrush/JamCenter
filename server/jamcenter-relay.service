[Unit]
Description=Jamcenter-Relay (Live-Musik zwischen zwei Raeumen)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/jamcenter-relay --ports 3478,443,47800
DynamicUser=yes
# Aufnahmen: /var/lib/jamcenter/aufnahmen (Liste und Download über TCP 47800)
StateDirectory=jamcenter
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
# Echtzeit-Priorität: Weiterleitung ohne Wartezeit, auch wenn Apache/PHP gerade rechnen.
# Die Schleifen blockieren in recv_from; die RT-Drosselung des Kernels (95 %) bleibt aktiv.
CPUSchedulingPolicy=fifo
CPUSchedulingPriority=50
Restart=always
RestartSec=1
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
MemoryMax=256M

[Install]
WantedBy=multi-user.target
